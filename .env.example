# ---- backend ----
# Comma-separated key pool (at least 2). Ids are key_1, key_2, ... in this order.
LLM_API_KEYS=your-groq-api-key,your-gemini-api-key
# LiteLLM model name used by every key
LLM_MODEL=groq/openai/gpt-oss-120b
# Optional: one model per key, same order as LLM_API_KEYS (e.g. mix providers)
LLM_KEY_MODELS=groq/openai/gpt-oss-120b,gemini/gemini-3.5-flash-lite
# SQLite file (inside the Docker volume mounted at /data)
DATABASE_URL=sqlite:////data/app.db
# Comma-separated CORS origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:3000
# true enables the X-Simulate-Failure test hook
ENABLE_FAILURE_SIMULATION=true
# Optional tuning
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise assistant.
LLM_CACHE_TTL_SECONDS=86400
LLM_TIMEOUT_SECONDS=12
LLM_MAX_OUTPUT_TOKENS=1024

# ---- frontend ----
# Backend URL the browser calls (docker: written to /config.js at container start)
PUBLIC_API_URL=http://localhost:8000
# Backend URL baked in at build time for static hosts (Vercel/Netlify)
VITE_API_URL=http://localhost:8000
